# AgencyKit configuration.
# Run ./scripts/setup.sh to create .env from this file with strong random secrets.
# Never commit .env.

# --- Database -------------------------------------------------------------
# Postgres superuser (used only by migrations and seed scripts).
POSTGRES_USER=agencykit_admin
POSTGRES_DB=agencykit
POSTGRES_PASSWORD=__GENERATED_DB_PASSWORD__
# Least-privilege role used by the running app. It is NOT a superuser and
# does NOT bypass row-level security.
APP_DB_PASSWORD=__GENERATED_APP_DB_PASSWORD__

# Host ports (bound to 127.0.0.1 only). 5433 avoids clashing with a local Postgres.
DB_PORT=5433
APP_PORT=3000

# Connection strings for local development (`npm run dev` with the db in Docker).
# Inside Docker Compose these are overridden to point at the `db` service.
DATABASE_URL=postgres://agencykit_app:__GENERATED_APP_DB_PASSWORD__@127.0.0.1:5433/agencykit
DATABASE_ADMIN_URL=postgres://agencykit_admin:__GENERATED_DB_PASSWORD__@127.0.0.1:5433/agencykit

# --- Auth -----------------------------------------------------------------
# 64 random bytes, base64. Used to sign session cookies (HS256).
AUTH_SECRET=__GENERATED_AUTH_SECRET__
# Set to false only if you serve the app over plain http on a non-localhost host.
COOKIE_SECURE=true
# After the first agency exists, public signup is closed unless this is true.
ALLOW_SIGNUP=false

# --- App ------------------------------------------------------------------
APP_URL=http://localhost:3000
# Create the "Northstar Digital" demo agency on first start (credentials are printed once in the logs).
SEED_DEMO=true

# --- AI (optional) --------------------------------------------------------
# Without a key, websites use built-in industry templates and the chat widget sends a polite hand-off reply.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
